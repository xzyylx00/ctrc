    PERCENT (267) 29
    DOT (268) 52
    MATCH (269) 25
    CASE (270) 28
    FUNCTION (271) 29
    TYPE (272) 54
    EXTERNAL (273) 39
    INTERNAL (274) 40
    IN (275) 77
    OUT (276) 78
    INOUT (277) 79
    REF (278) 81
    PTR (279) 80
