State 0

    0 $accept: • Program $end

    LBRACE      shift, and go to state 1
    LPAREN      shift, and go to state 2
    UNDERSCORE  shift, and go to state 3
    MATCH       shift, and go to state 4
    FUNCTION    shift, and go to state 5
    TYPE        shift, and go to state 6
    IN          shift, and go to state 7
    OUT         shift, and go to state 8
    INOUT       shift, and go to state 9
    REF         shift, and go to state 10
    PTR         shift, and go to state 11
